<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- talond as a per-user LaunchAgent: no admin, your processes only. `make agent` fills in __BIN__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.kanishk.talond.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>--agent</string>
  </array>
  <key>MachServices</key><dict><key>dev.kanishk.talond.agent</key><true/></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Adaptive</string>
</dict>
</plist>
